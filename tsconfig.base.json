{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "lib": ["DOM", "ES2015", "ES6", "DOM.Iterable", "ScriptHost"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "strict": true,
  },
  "include": [
    "typings/**/*",
    "src/**/*"
  ]
}